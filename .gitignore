/projects/
/voices/
/outputs/
/editor_sources/
/models/
/cache/

# Python virtual environments and generated files.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/

# Test, lint, type-check and coverage caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
